# Copy to .env and fill in your local paths.
# Both BASE_DIR and OUTPUT_DIR must exist before running the pipeline.

# BASE_DIR: parent directory of `data/`, which holds the input data:
#   data/stroop_task_info.csv, data/wcst_task_info.csv
#       one row per session: filename, subj_id, task_id, task_order
#   data/stroop/, data/wcst/
#       SNIRF files and NeuroLume_{subject}_{task_id}_task_events.tsv
#   data/assessments/
#       {executive_function,phq9,gad7,craving,tea}_{timepoint}.csv
#   data/atlas/
#       flow2_absorption_Schaefer2018_100Parcels_7Networks.npz,
#       Schaefer2018_100Parcels_7Networks_order.txt
BASE_DIR=/path/to/your/OUD-tPBM

# OUTPUT_DIR: where pipeline outputs are written
# (a run tree: 01_assessments/, 02_behav/, 03_glm/, ..., 09_hypothesis_testing/,
# 10_longitudinal/, plus analysis_variant.json; see "Running the pipeline" in
# README.md). The figure scripts write under OUTPUT_DIR/figures/.
OUTPUT_DIR=/path/to/your/OUD-tPBM/output

# PROTECTED_TREE_MARKERS: optional. Comma-separated path fragments that mark
# finished reference run trees; every stage that writes into OUTPUT_DIR, and
# the figure scripts, refuse an OUTPUT_DIR containing one of them. Unset or
# empty, nothing is protected.
PROTECTED_TREE_MARKERS=runs/archive,frozen_outputs

# SLURM_MAIL_USER: optional. When set, the SLURM wrappers add
# --mail-type=FAIL,END --mail-user=<this address> to job submissions.
# Leaving it unset disables SLURM mail flags entirely.
SLURM_MAIL_USER=

# HYGIENE_SITE_ROOTS, HYGIENE_ID_PATTERNS: optional, for
# scripts/check_public_hygiene.py. Blank entries are ignored.
# HYGIENE_SITE_ROOTS is a comma-separated list of this site's top-level
# storage directories: an absolute path under any of them (e.g. /sitex/...)
# fails the check, in addition to the user-directory roots (Users, home),
# which are always checked. Do not list a name the repository uses as a
# relative directory (such as data): that would flag its own relative paths.
# HYGIENE_ID_PATTERNS is a semicolon-separated list of regexes for the raw
# participant-ID scheme, matched case-insensitively; semicolons because a
# regex may contain a comma, as in ID[0-9]{2,3}.
# Unset, both rules run with generic defaults only; the pre-publication run
# uses --require-settings, which fails when either is unset.
# HYGIENE_SITE_ROOTS=sitex
# HYGIENE_ID_PATTERNS=RAWID[-_]?[0-9]+
